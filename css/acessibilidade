/* MODO DARK */
.dark-mode {
  background-color: #121212;
  color: #e0e0e0;
}

.dark-mode header {
  background: linear-gradient(90deg, #440000 0%, #000044 50%, #000000 100%);
  color: #ddd;
}

.dark-mode section {
  background-color: #1e1e1e;
  color: #ccc;
  border-radius: 8px;
}

.dark-mode .card {
  background-color: #2c2c2c;
  color: #eee;
}

.dark-mode .produto {
  background-color: black;
  color: #eee;
}

.dark-mode .btn {
  background-color: #333;
  color: #4CAF50;
}

.dark-mode .btn:hover {
  background-color: #555;
}

.dark-mode footer {
  background: #000;
  color: white;
}

.dark-mode .footer-social a {
  color: #aaa;
}

.dark-mode .footer-social a:hover {
  color: #fff;
}

.dark-mode .btn-destaque {
  background: linear-gradient(to right, #440000 0%, #000044 50%, #000000 100%);
  color: #fff;
  border-color: #444;
  box-shadow: 0 4px 8px rgba(255, 255, 255, 0.1);
}

.dark-mode .btn-destaque:hover {
  background: linear-gradient(to right, #000000 0%, #000044 50%, #440000 100%);
  border-color: #fff;
}

.dark-mode input,
.dark-mode textarea {
  background-color: #333;
  color: #eee;
  border: 1px solid #555;
}

.dark-mode button {
  background-color: black;
  color: #fff;
  border: 2px solid white;
}

.dark-mode button:hover {
  background-color: #000;
}

/* Ajuste para o botão flutuante WhatsApp no modo dark */
.dark-mode .whatsapp-float-btn {
  background-color: black;
}

.dark-mode .whatsapp-float-btn:hover {
  background-color: white;
}

body.dark-mode .footer-social a {
  background-color: #fff; /* fundo branco translúcido */
  box-shadow: 0 0 8px rgba(255, 255, 255, 0.2);
}

body.dark-mode .formulario {
  background-color: #1e1e2f;
  color: #f0f0f0;
  box-shadow: 0 0 15px rgba(255, 255, 255, 0.05);
}

body.dark-mode .formulario input,
body.dark-mode .formulario textarea {
  background-color: #2a2a3d;
  color: #ffffff;
  border: 1px solid #555;
}

body.dark-mode .formulario input::placeholder,
body.dark-mode .formulario textarea::placeholder {
  color: #bbbbbb;
}

body.dark-mode .formulario label {
  color: #ffffff;
}

body.dark-mode .formulario .mensagem {
  color: #ff6b6b; /* vermelho claro para erro */
}

/* PRODUTOS - MODO DARK */
body.dark-mode .produto-container {
  background-color: #1a1a2d;
  color: #e0e0e0;
  box-shadow: 0 0 10px rgba(255, 255, 255, 0.05);
}

body.dark-mode .produto-container.reverse {
  background-color: #1a1a2d;
}

body.dark-mode .produto-info h2 {
  color: #ffffff;
}

body.dark-mode .produto-info p {
  color: #fff;
}

body.dark-mode .produto-imagem img {
  box-shadow: 0 4px 12px rgba(255, 255, 255, 0.1);
  border: 1px solid #333;
}

/* Botão Ver Mais no Dark */
body.dark-mode .btn-ver-mais {
  background-color: black;
  color: #fff;
  border: 2px solid #ffffff;
}

body.dark-mode .btn-ver-mais:hover {
  background-color: #000000;
  color: #fff;
  border: 2px solid #ff4444;
}

/* Botão Comprar no Dark */
body.dark-mode .btn-comprar {
  background-color: black;
  color: #fff;
}

body.dark-mode .btn-comprar:hover {
  background-color: #003333;
}

body.dark-mode .btn-voltar {
  background-color: black;
  color: white;
}






