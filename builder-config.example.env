# Copie os campos abaixo para o .env já existente. Não substitua suas configurações atuais.
# Mantenha 0 até concluir os testes de pagamento, e-mail, webhook e cron na hospedagem compatível.
BUILDER_ENABLED=0
# infinityfree: confirmação pela página do pedido; sem webhook/cron.
BUILDER_HOSTING_MODE=infinityfree
BUILDER_BASE_URL=https://SEU-DOMINIO
BUILDER_APP_KEY=GERAR_64_CARACTERES_HEXADECIMAIS_ALEATORIOS
BUILDER_CONTACT_EMAIL=felippefardin@gmail.com
# test usa sandbox_init_point e rejeita pagamentos live_mode=true.
# production usa init_point e rejeita pagamentos live_mode=false.
MP_MODE=test
MP_ACCESS_TOKEN=PREENCHER_SOMENTE_NO_ENV_DO_SERVIDOR
MP_COLLECTOR_ID=ID_DA_CONTA_RECEBEDORA
MP_WEBHOOK_SECRET=SEGREDO_DO_WEBHOOK
# SMTP_USERNAME, SMTP_PASSWORD, SMTP_HOST, SMTP_PORT e SMTP_FROM_EMAIL
# usam as configurações já existentes no site. Não há credenciais neste pacote.
